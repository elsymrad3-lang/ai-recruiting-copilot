    {
      "parameters": {
        "jsCode": "// Decide what this CV is: a new person, a newer CV, a duplicate, an older CV, or a name clash to review\nconst cv = $('Parse CV').first().json;\nconst p = cv.profile;\nconst people = $('Get Candidates').all().map(i => i.json).filter(c => c.id);\nconst digits = s => String(s || '').replace(/\\D/g, '').slice(-9);\nconst lc = s => String(s || '').toLowerCase().trim();\nconst match =\n  people.find(c => p.email && lc(c.email) === p.email) ||\n  people.find(c => p.phone_digits.length >= 7 && digits(c.phone) === p.phone_digits);\nconst newDate = p.cv_date || '';\nconst oldDate = match ? (match.cv_date || '') : '';\nlet action, reason = null;\nif (!match) {\n  action = people.some(c => lc(c.full_name) === lc(p.full_name)) ? 'review' : 'new';\n  if (action === 'review') reason = 'Same name as an existing candidate but a different email and phone. Check by hand.';\n} else if (newDate > oldDate) action = 'update';\nelse if (newDate === oldDate) { action = 'duplicate'; reason = `Same CV as ${match.active_cv_file}`; }\nelse { action = 'older'; reason = `Older than ${match.active_cv_file}`; }\nreturn [{ json: { ...cv, action, reason, match: match || null } }];"
      },
