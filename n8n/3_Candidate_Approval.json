        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"temperature\": 0,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Write one friendly, professional sentence (at most 30 words) telling a candidate why their experience fits a remote role. Use only the facts given. Do not mention scores. Return only JSON in this shape: {\\\"intro\\\":\\\"\\\"}\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify('Role: ' + $json.role_title + '. Facts: ' + $json.line1 + ' ' + $json.line2) }} }\n  ]\n}",
        "options": {}
      },
