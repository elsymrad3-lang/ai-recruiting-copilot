      "parameters": {
        "jsCode": "// ===== YOUR GHL SETTINGS: paste your own IDs between the quotes =====\nconst SETTINGS = {\n  location_id: 'yLiKZKvk2CeI2ckIqd1L',\n  pipeline_id: 'wVR2sMaNCvCdGXcDhm4L',\n  stage_shortlisted_id: '3b126dd8-78a4-4b9f-bc2e-c20a3acf19be',\n  field_role_title_id: 'UX73MimTInvctq96IIvX',\n  field_outreach_intro_id: 'l7bDtMlaaCR7ohP4hgHh',\n  tag: 'em-outreach-approved',\n  // TEST MODE ON: GHL gets your own Gmail +alias (e.g. elsymrad3+linahaddad@gmail.com),\n  // never the address written in the CV. Set to false only for real candidates.\n  test_mode: true,\n  test_inbox: 'elsymrad3',\n};\n// =====================================================================\nconst c = $('When Executed by Another Workflow').first().json;\nlet intro = '';\ntry { intro = JSON.parse($json.choices[0].message.content).intro || ''; } catch (e) {}\nconst slug = String(c.name || 'candidate').toLowerCase().replace(/[^a-z0-9]+/g, '');\nconst ghl_email = SETTINGS.test_mode ? `${SETTINGS.test_inbox}+${slug}@gmail.com` : c.email;\nconst [first_name, ...rest] = String(c.name || '').split(' ');\nreturn [{ json: { ...c, intro, ghl_email, first_name, last_name: rest.join(' '), settings: SETTINGS } }];"
