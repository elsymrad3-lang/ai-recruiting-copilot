      "name": "Get Pipelines",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "MunLcnbcZYsFSLsd",
          "name": "GHL - EM"
        }
      }
    },
    {
      "parameters": {
        "url": "https://services.leadconnectorhq.com/opportunities/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "location_id",
              "value": "={{ $('Settings').first().json.location_id }}"
            },
            {
              "name": "pipeline_id",
              "value": "={{ $('Settings').first().json.pipeline_id }}"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "d7b9fcb2-d92f-4582-8d6d-11c46c5fbc43",
      "name": "Get Opportunities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "MunLcnbcZYsFSLsd",
          "name": "GHL - EM"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const S = $('Settings').first().json;\nconst pipe = ($('Get Pipelines').first().json.pipelines || []).find(p => p.id === S.pipeline_id);\nif (!pipe) throw new Error('Pipeline not found: paste your EM - Candidate Pipeline ID in the Settings node');\nconst names = Object.fromEntries(pipe.stages.map(s => [s.id, s.name]));\nreturn ($json.opportunities || [])\n  .filter(o => o.contact && o.contact.name && names[o.pipelineStageId])\n  .map(o => ({ json: { name: o.contact.name, stage: names[o.pipelineStageId] } }));"
      },
      "id": "95368c11-1785-43bb-85c2-d71d46805701",
      "name": "Map Stages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "candidates",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "full_name",
              "condition": "ilike",
              "keyValue": "={{ $json.name }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "pipeline_stage",
              "fieldValue": "={{ $json.stage }}"
            }
          ]
        }
      },
      "id": "76070f65-4586-4ce9-8839-67fa0854d57d",
      "name": "Update Stage",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1104,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "TdhVA0PuKtKcDes6",
          "name": "Supabase - Recruiting"
        }
      }
    }
  ],
