        "jsCode": "// ===== paste your EM - Candidate Pipeline ID between the quotes =====\nreturn [{ json: { location_id: 'yLiKZKvk2CeI2ckIqd1L', pipeline_id: 'wVR2sMaNCvCdGXcDhm4L' } }];"
      },
      "id": "ae8fc287-c9e1-4e07-925e-aa1c65ea9fcd",
