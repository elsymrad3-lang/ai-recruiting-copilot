        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "TdhVA0PuKtKcDes6",
          "name": "Supabase - Recruiting"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#recruiting-approvals",
          "mode": "name"
        },
        "text": "=:incoming_envelope: *{{ $('Read Reply').item.json.name }}* ({{ $('Read Reply').item.json.email }}) replied to the outreach email. The sequence stopped automatically and the GHL stage is now *Replied*.",
        "otherOptions": {
          "includeLinkToWorkflow": false
