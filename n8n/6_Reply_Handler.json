    },
    {
      "parameters": {
        "jsCode": "// GHL sends the contact's details in the body\nconst b = $json.body || {};\nconst name = b.full_name || [b.first_name, b.last_name].filter(Boolean).join(' ') || (b.contact && b.contact.name) || '';\nreturn [{ json: { name, email: b.email || '' } }];"
      },
      "id": "a4414e28-b15d-402a-8843-7e17f8bf8c50",
      "name": "Read Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "candidates",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "full_name",
              "condition": "ilike",
              "keyValue": "={{ $json.name }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "pipeline_stage",
              "fieldValue": "Replied"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "id": "6bea4b63-73b4-465a-b3dc-4154ddc295f2",
      "name": "Mark Replied",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
